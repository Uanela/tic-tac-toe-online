model RankWatch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  board RankBoard

  rank Int

  @@unique([playerId, board])
}

enum RankBoard {
  Championship
  Global
}
