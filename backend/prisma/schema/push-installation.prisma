/// One Firebase Installation per browser install. Its presence is also what tells the
/// delivery path that this user can be reached by push, so it is only dropped when FCM
/// reports the installation permanently dead.
model PushInstallation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A Firebase installation id, or the browser's own key when it refused on the spot.
  installationId String               @unique
  status         PushPermissionStatus @default(Granted)

  @@index([userId])
}

enum PushPermissionStatus {
  Granted
  Denied
}
