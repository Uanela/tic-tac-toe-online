# Build and output directories
/build
/dist
/.dist
/out
/.build
/coverage
/.nyc_output

# Arkos.js' base uploads directory
/uploads

# TypeScript cache, declaration files and side-emits. The compiler has no outDir,
# so a bare `tsc` drops .js next to every .ts and Node would then resolve the stale
# copy ahead of the source. The real build goes to /.build.
*.tsbuildinfo
/src/**/*.js.map
/src/**/*.d.ts
/src/**/*.js
/arkos.config.js
/types/generated/*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

